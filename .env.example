# PostgreSQL (required; URL-encode special characters in the password)
DATABASE_URL="postgresql://USER:URL_ENCODED_PASSWORD@HOST:5432/DATABASE"

# Local development: match the exact URL/port you open in your browser.
AUTH_ORIGIN="http://localhost:5173"

# Production (one deployment serves both public and admin domains):
# AUTH_ORIGIN="https://admin.aaryandehade.com"
# PROTOCOL_HEADER="x-forwarded-proto"
# HOST_HEADER="x-forwarded-host"
# Remove ORIGIN from production runtime AND build environment variables.
# Only trust forwarded headers when traffic reaches the app through your proxy.

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Admin Restriction
ADMIN_EMAIL=""

